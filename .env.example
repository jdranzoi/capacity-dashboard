# Copy to `.env.local` and fill with values from the Supabase project (Settings > API) and your team.
# Never commit `.env.local`.

NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Shared secret for POST /api/revalidate (sync webhook / manual cache bust) >> comand: openssl rand -base64 32
DASHBOARD_CACHE_REVALIDATE_SECRET=
