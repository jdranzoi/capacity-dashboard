# Copy to `.env.local` and fill with values from the Supabase project (Settings > API) and your team.
# Never commit `.env.local`.

NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Sync freshness (see lib/sync/dashboard-sync-env.ts) 
DASHBOARD_SYNC_POLL_INTERVAL_MS=90000
DASHBOARD_SYNC_REVALIDATE_SECRET= # Random secret; generate once per environment:openssl rand -base64 32
